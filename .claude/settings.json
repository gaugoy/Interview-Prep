{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/post_edit.py\"",
            "timeout": 30,
            "statusMessage": "Validating edited content file…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/on_stop.py\"",
            "timeout": 120,
            "statusMessage": "Rebuilding question index…"
          }
        ]
      }
    ]
  }
}
